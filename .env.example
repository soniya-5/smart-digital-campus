# Environment configuration template for Smart Digital Campus System
# Copy this file to backend/.env and adjust configuration as needed

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Secret keys for secure token and session handling (replace with strong random keys in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_minimum_32_characters

# Database Connection:
# Out-of-the-box local development runs on SQLite (zero configuration needed):
DATABASE_URL="file:./dev.db"

# To switch to a PostgreSQL instance in production or Docker, update provider in backend/prisma/schema.prisma:
# DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campus_db?schema=public"
